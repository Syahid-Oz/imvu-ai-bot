# =====================================================================
# IMVU AI Bot configuration
# Copy this file to .env and fill in your own values.
# NEVER commit .env to Git (it is already covered by .gitignore).
# =====================================================================

# --- IMVU account ----------------------------------------------------
# Your own IMVU account credentials. Used only to authenticate with
# https://api.imvu.com via the @imvu/client library.
IMVU_USERNAME=your_username
IMVU_PASSWORD=your_password

# Optional: single-use two-factor code, only if your account has 2FA enabled.
# Generate a fresh code from your authenticator app each time you start the bot.
#IMVU_2FA_CODE=

# --- Room -------------------------------------------------------------
# The ONLY room this bot connects to. Must be a room your account can access
# (your own room). Format examples: 123456789 or 123456789-12
IMVU_ROOM_ID=123456789

# Optional: IMQ realtime endpoint override (advanced).
#IMQ_URL=wss://imq.imvu.com:444/streaming/imvu_pre

# --- AI ---------------------------------------------------------------
# The bot works with ANY OpenAI-compatible chat completions provider.
# Configure AI_API_KEY + AI_BASE_URL + AI_MODEL for the provider you choose.
# The key is sent ONLY to the AI endpoint, never to IMVU, never logged.

# >>> Option A: OpenRouter (free key: https://openrouter.ai/keys) <<<
# Model names use the "provider/model" format; ":free" models cost nothing.
AI_API_KEY=your_openrouter_api_key
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=minimax/minimax-m3:free
# More free models: google/gemma-4-31b-it:free, z-ai/glm-5.2:free,
# nvidia/nemotron-3-super-120b-a12b:free, openrouter/free

# >>> Option B: NVIDIA NIM (free 1000 credits: https://build.nvidia.com) <<<
#AI_API_KEY=your_nvidia_api_key
#AI_BASE_URL=https://integrate.api.nvidia.com/v1
#AI_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# More NVIDIA chat models: mistralai/mistral-7b-instruct-v0.3,
# mistralai/mistral-large-2-instruct, openai/gpt-oss-20b

# >>> Option C: OpenAI (the original default) <<<
#AI_API_KEY=your_openai_api_key
#AI_BASE_URL=https://api.openai.com/v1
#AI_MODEL=gpt-4o-mini

# --- Bot Personality & Owner ------------------------------------------
# The persona description used in the AI system prompt.
# Customize the bot's personality, tone, and behavior here.
# Example: "a friendly and playful IMVU chat companion who loves anime"
AI_PERSONA=a friendly and helpful IMVU assistant

# Bot display name. Users must mention this name to trigger a room reply.
# Keep the real bot name only in your private .env file.
BOT_NAME=your_bot_name

# --- Owner Information ------------------------------------------------
# The owner's name/ID that users can reference when they need help.
# If the bot doesn't understand something, it can direct users to
# contact the owner on IMVU. Set this to your IMVU username in .env.
OWNER_NAME=your_owner_name

# The owner's IMVU user ID (optional, used for direct lookups).
# You can find this in your IMVU profile URL: https://www.imvu.com/avatar/<id>
# Keep the real ID only in your private .env file.
#OWNER_ID=your_imvu_id

# --- Auto Features -----------------------------------------------------
# Enable auto-reply to private/inbox messages in addition to room chat.
# When enabled, the bot will reply to any private message it receives.
# Set to "true" or "false" (default: true).
AUTO_REPLY_INBOX=true

# Enable auto-accept friend requests.
# When enabled, the bot will automatically accept any incoming friend request.
# Set to "true" or "false" (default: true).
AUTO_ACCEPT_FRIENDS=true

# --- Keep-Alive --------------------------------------------------------
# Automatically reconnect and stay online 24/7.
# The bot will attempt to reconnect indefinitely if the connection drops.
#KEEP_ALIVE=true
